---
import type { Lang } from '../types';
import { t, formatLocaleUrl } from '../i18n/ui';
import { categories, siteInfo } from '../utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="bg-navy text-slate-300 pt-16 pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800">
      
      <!-- Company Brand & Summary (2 cols on lg) -->
      <div class="lg:col-span-2 space-y-4">
        <a href={formatLocaleUrl(lang, '/')} class="inline-block focus:outline-hidden focus:ring-2 focus:ring-brand-blue rounded-lg">
          <img
            src="/images/brand/logo-dark-bg.png"
            alt="青瑾机械 QING JIN MACHINERY"
            class="h-14 w-auto object-contain"
            width="200"
            height="56"
            onerror="this.style.display='none'"
          />
        </a>
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-yellow">
          {siteInfo.tagline[lang]}
        </p>
        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          {t(lang, 'footer.desc')}
        </p>
        <div class="pt-2 flex flex-wrap gap-2 text-xs">
          <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 border border-slate-700">
            {siteInfo.factoryPitch[lang]}
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 border border-slate-700">
            {siteInfo.certPitch[lang]}
          </span>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">
          {t(lang, 'footer.quickLinks')}
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={formatLocaleUrl(lang, '/')} class="hover:text-white transition-colors">
              {t(lang, 'nav.home')}
            </a>
          </li>
          <li>
            <a href={formatLocaleUrl(lang, '/products/')} class="hover:text-white transition-colors">
              {t(lang, 'nav.products')}
            </a>
          </li>
          <li>
            <a href={formatLocaleUrl(lang, '/compare/')} class="hover:text-white transition-colors">
              {t(lang, 'nav.compare')}
            </a>
          </li>
          <li>
            <a href={formatLocaleUrl(lang, '/about/')} class="hover:text-white transition-colors">
              {t(lang, 'nav.about')}
            </a>
          </li>
          <li>
            <a href={formatLocaleUrl(lang, '/contact/')} class="hover:text-white transition-colors">
              {t(lang, 'nav.contact')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Product Categories -->
      <div class="space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">
          {t(lang, 'footer.categories')}
        </h3>
        <ul class="space-y-2 text-sm">
          {categories.slice(0, 6).map((cat) => (
            <li>
              <a
                href={`${formatLocaleUrl(lang, '/products/')}?cat=${cat.id}`}
                class="hover:text-white transition-colors flex items-center justify-between"
              >
                <span>{cat.name[lang]}</span>
                <span class="text-xs text-slate-500 font-mono">({cat.count})</span>
              </a>
            </li>
          ))}
          {categories.length > 6 && (
            <li>
              <a
                href={formatLocaleUrl(lang, '/products/')}
                class="text-xs text-brand-blue hover:text-white underline font-medium"
              >
                {t(lang, 'products.allCategories')} &rarr;
              </a>
            </li>
          )}
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">
          {t(lang, 'footer.contactUs')}
        </h3>
        <div class="space-y-2 text-sm text-slate-400">
          <p class="leading-relaxed">
            <span class="block text-xs font-semibold text-slate-300 uppercase">{t(lang, 'contact.factoryAddress')}</span>
            <span class="text-xs">{siteInfo.address[lang]}</span>
          </p>
          <p>
            <span class="block text-xs font-semibold text-slate-300 uppercase">{t(lang, 'contact.phone')}</span>
            <span class="text-xs font-mono text-slate-200">{siteInfo.contact.phone}</span>
          </p>
          <p>
            <span class="block text-xs font-semibold text-slate-300 uppercase">{t(lang, 'contact.email')}</span>
            <a href={`mailto:${siteInfo.contact.email}`} class="text-xs font-mono text-brand-blue hover:underline">
              {siteInfo.contact.email}
            </a>
          </p>
          <div class="pt-1 flex gap-4 text-xs">
            <div>
              <span class="text-slate-500 uppercase">WhatsApp:</span>{' '}
              <span class="font-mono text-slate-300">{siteInfo.contact.whatsapp}</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Badges -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>
        &copy; {currentYear} {siteInfo.name[lang]}. {t(lang, 'footer.rights')}
      </p>
      <div class="flex items-center gap-4">
        <span>CE Machinery & EMC Directive</span>
        <span>•</span>
        <span>Factory Direct</span>
        <span>•</span>
        <span>Made in Quanzhou, Fujian</span>
      </div>
    </div>
  </div>
</footer>
