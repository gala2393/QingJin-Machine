---
import type { Machine, Lang } from '../types';
import { t, formatLocaleUrl } from '../i18n/ui';
import { PLACEHOLDER_SVG } from '../utils';

interface Props {
  machine: Machine;
  lang: Lang;
  priority?: boolean;
}

const { machine, lang, priority = false } = Astro.props;

// Top 2-3 parameters to display on card
const displayParams = machine.params.slice(0, 3);

// Search string pre-computed for fast client-side filtering
const searchTokens = [
  machine.model,
  machine.model.replace(/[\s\-_·.]/g, ''),
  machine.name.zh,
  machine.name.en,
  ...machine.params.map((p) => `${p.zh} ${p.en} ${p.value_zh} ${p.value_en}`),
]
  .join(' ')
  .toLowerCase();
---

<article
  data-machine-card
  data-category={machine.category}
  data-search={searchTokens}
  data-machine-id={machine.id}
  class="group flex flex-col bg-white rounded-2xl border border-slate-200/90 shadow-xs hover:shadow-xl hover:border-brand-blue/30 transition-all duration-300 overflow-hidden relative"
>
  <!-- Image Container -->
  <a
    href={formatLocaleUrl(lang, `/products/${machine.id}/`)}
    class="relative w-full aspect-square sm:aspect-4/3 bg-surface p-2 sm:p-4 flex items-center justify-center overflow-hidden border-b border-slate-100 block"
    aria-label={`${machine.model} - ${machine.name[lang]}`}
  >
    <img
      src={machine.image}
      alt={`${machine.model} - ${machine.name[lang]}`}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
      onerror={`this.onerror=null;this.src='${PLACEHOLDER_SVG}';`}
    />

    <!-- Model Tag Float Badge -->
    <span class="absolute top-2 left-2 sm:top-3 sm:left-3 max-w-[calc(100%-1rem)] truncate inline-flex items-center px-1.5 sm:px-2.5 py-0.5 sm:py-1 rounded-md text-[10px] sm:text-xs font-bold tracking-wide bg-primary text-white shadow-xs">
      {machine.model}
    </span>
  </a>

  <!-- Card Body -->
  <div class="flex flex-col flex-1 p-3 sm:p-5">
    <div class="mb-2 sm:mb-3">
      <h3 class="text-sm sm:text-base font-bold text-navy line-clamp-2 sm:line-clamp-1 leading-snug group-hover:text-primary transition-colors">
        <a href={formatLocaleUrl(lang, `/products/${machine.id}/`)}>
          {machine.name[lang]}
        </a>
      </h3>
    </div>

    <!-- Parameter Highlights (First 2-3 params) -->
    <dl class="space-y-1.5 text-[11px] sm:text-xs text-slate-600 mb-3 sm:mb-5 flex-1 bg-slate-50/80 rounded-lg sm:rounded-xl p-2 sm:p-3 border border-slate-100">
      {displayParams.map((param) => (
        <div class="flex items-center justify-between gap-2 border-b border-slate-200/50 pb-1 last:border-0 last:pb-0 max-sm:nth-3:hidden max-sm:nth-2:border-0 max-sm:nth-2:pb-0">
          <dt class="text-slate-500 truncate max-w-[45%]">
            {param[lang] || param.zh}
          </dt>
          <dd class="font-medium text-navy text-right truncate">
            {param[`value_${lang}`] || param.value_zh}
          </dd>
        </div>
      ))}
    </dl>

    <!-- Bottom Actions -->
    <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2 mt-auto">
      <a
        href={formatLocaleUrl(lang, `/products/${machine.id}/`)}
        class="hidden sm:inline-flex items-center gap-1 text-xs font-bold text-primary hover:text-brand-blue group-hover:translate-x-0.5 transition-all"
      >
        <span>{t(lang, 'common.viewDetails')}</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <!-- Compare Checkbox/Button -->
      <button
        type="button"
        data-compare-btn
        data-machine-id={machine.id}
        data-msg-max={t(lang, 'compare.maxAlert')}
        data-txt-add={t(lang, 'common.addToCompare')}
        data-txt-added={t(lang, 'common.inCompare')}
        class="w-full sm:w-auto justify-center inline-flex items-center gap-1.5 px-2.5 py-2 sm:py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-primary hover:bg-primary-light/50 border border-slate-200 transition-colors focus:outline-hidden"
      >
        <svg class="w-3.5 h-3.5 check-icon hidden text-primary" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        <span class="compare-btn-text">{t(lang, 'common.addToCompare')}</span>
      </button>
    </div>
  </div>
</article>
