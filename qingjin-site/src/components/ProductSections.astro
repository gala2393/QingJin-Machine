---
import type { Lang, MachineSection } from '../types';

interface Props {
  sections: MachineSection[];
  lang: Lang;
  model: string;
}

const { sections, lang, model } = Astro.props;

// An English page falls back to the Chinese text when the English field is empty, like the parameter table.
const pick = (v: { zh: string; en: string }) => (lang === 'en' ? v.en || v.zh : v.zh);
const visible = sections.filter((s) => s.items.length > 0);
const galleryUrls = visible.map((s) => (s.kind === 'gallery' ? s.items.map((i) => i.image ?? '') : []));
---

{visible.length > 0 && (
  <div class="mt-12 space-y-10" data-sections>
    {visible.map((s, si) => (
      <section aria-labelledby={`section-${si}`}>
        <h2 id={`section-${si}`} class="text-base sm:text-lg font-bold text-navy flex items-center gap-2 pb-2 border-b border-slate-200">
          <span class="inline-block w-1 h-5 rounded-full bg-primary"></span>
          <span>{pick(s.title)}</span>
        </h2>

        {s.desc && pick(s.desc) && (
          <p class="mt-3 text-sm text-slate-600 leading-relaxed whitespace-pre-line">{pick(s.desc)}</p>
        )}

        {s.kind === 'text' ? (
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {s.items.map((it) => (
              <li class="flex gap-3 p-4 rounded-xl bg-surface border border-slate-200/80">
                <svg class="w-5 h-5 mt-0.5 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm text-slate-700 leading-relaxed">{pick(it)}</span>
              </li>
            ))}
          </ul>
        ) : (
          <ul class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
            {s.items.map((it, ii) => (
              <li>
                <figure class="group">
                  <button
                    type="button"
                    data-section-open={`${si}:${ii}`}
                    class="block w-full overflow-hidden rounded-xl border border-slate-200 bg-white aspect-square focus:outline-hidden focus:ring-2 focus:ring-primary"
                    aria-label={pick(it) || `${model} ${pick(s.title)} ${ii + 1}`}
                  >
                    <img
                      src={it.image}
                      alt={pick(it) || `${model} - ${pick(s.title)} (${ii + 1})`}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  </button>
                  {pick(it) && <figcaption class="mt-2 text-center text-xs sm:text-sm text-slate-600 leading-snug">{pick(it)}</figcaption>}
                </figure>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}

    <dialog data-section-box class="m-auto max-w-[min(96vw,1100px)] max-h-[92vh] bg-transparent p-0 backdrop:bg-slate-900/80">
      <div data-section-stage class="relative flex items-center justify-center">
        <img data-section-img src="" alt="" class="max-w-full max-h-[88vh] rounded-lg bg-white" />
        <button type="button" data-section-close aria-label={lang === 'zh' ? '关闭' : 'Close'} class="absolute top-2 right-2 w-9 h-9 rounded-full bg-slate-900/70 text-white text-xl leading-none">×</button>
        <button type="button" data-section-prev aria-label={lang === 'zh' ? '上一张' : 'Previous'} class="absolute left-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-slate-900/70 text-white">‹</button>
        <button type="button" data-section-next aria-label={lang === 'zh' ? '下一张' : 'Next'} class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-slate-900/70 text-white">›</button>
      </div>
    </dialog>
    <script type="application/json" data-section-urls set:html={JSON.stringify(galleryUrls)}></script>
  </div>
)}

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-sections]')) {
    const box = root.querySelector<HTMLDialogElement>('[data-section-box]');
    const img = root.querySelector<HTMLImageElement>('[data-section-img]');
    const raw = root.querySelector('[data-section-urls]')?.textContent;
    if (!box || !img || !raw || typeof box.showModal !== 'function') continue;
    const urls = JSON.parse(raw) as string[][];
    let section = 0;
    let index = 0;

    const show = (i: number) => {
      const list = urls[section] ?? [];
      if (!list.length) return;
      index = (i + list.length) % list.length;
      img.src = list[index];
      const single = list.length < 2;
      box.querySelector<HTMLElement>('[data-section-prev]')!.hidden = single;
      box.querySelector<HTMLElement>('[data-section-next]')!.hidden = single;
    };

    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-section-open]');
      if (!btn) return;
      const [s, i] = (btn.dataset.sectionOpen ?? '0:0').split(':').map(Number);
      section = s;
      show(i);
      box.showModal();
    });
    box.querySelector('[data-section-close]')?.addEventListener('click', () => box.close());
    box.querySelector('[data-section-prev]')?.addEventListener('click', () => show(index - 1));
    box.querySelector('[data-section-next]')?.addEventListener('click', () => show(index + 1));
    box.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === box || t.hasAttribute('data-section-stage')) box.close();
    });
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      else if (e.key === 'ArrowRight') show(index + 1);
    });
  }
</script>
