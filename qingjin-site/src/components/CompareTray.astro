---
import type { Lang } from '../types';
import { t, formatLocaleUrl } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div
  id="qj-compare-tray"
  class="hidden fixed bottom-[calc(1rem+env(safe-area-inset-bottom))] left-0 right-0 mx-auto z-40 w-[94%] max-w-xl bg-navy/95 backdrop-blur-md text-white rounded-2xl shadow-2xl border border-slate-700/80 p-3 sm:px-5 sm:py-3.5 transition-all duration-300 ease-out"
  role="region"
  aria-label={t(lang, 'compare.trayTitle')}
>
  <div class="flex items-center justify-between gap-3">
    <!-- Left: Indicator & model count -->
    <div class="flex items-center gap-2 sm:gap-3 min-w-0">
      <div class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center shrink-0">
        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
      </div>
      <div class="min-w-0">
        <p class="text-xs sm:text-sm font-semibold flex items-center gap-1.5 min-w-0">
          <span class="truncate">{t(lang, 'compare.trayTitle')}</span>
          <span id="compare-tray-counter" class="text-brand-yellow font-mono font-bold text-xs bg-slate-800/80 px-2 py-0.5 rounded-full">
            0/4
          </span>
        </p>
        <p class="text-[11px] text-slate-400 hidden sm:block">
          {lang === 'zh' ? '已选择机型横向参数比对' : 'Side-by-side spec comparison'}
        </p>
      </div>
    </div>

    <!-- Right: Actions -->
    <div class="flex items-center gap-1 sm:gap-2 shrink-0">
      <button
        id="compare-tray-clear"
        type="button"
        class="px-2.5 py-1.5 text-xs text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition-colors focus:outline-hidden"
      >
        {t(lang, 'common.clear')}
      </button>

      <a
        id="compare-tray-link"
        href={formatLocaleUrl(lang, '/compare/')}
        class="inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-2 whitespace-nowrap text-xs sm:text-sm font-semibold bg-brand-blue hover:bg-blue-600 text-white rounded-lg shadow-sm transition-all focus:outline-hidden"
      >
        <span>{t(lang, 'compare.trayAction')}</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  function setupCompareTray() {
    const tray = document.getElementById('qj-compare-tray');
    const counter = document.getElementById('compare-tray-counter');
    const clearBtn = document.getElementById('compare-tray-clear');

    if (!tray || !counter) return;

    function refresh() {
      if (!tray || !counter) return;
      try {
        const raw = localStorage.getItem('qj-compare');
        const list = raw ? JSON.parse(raw) : [];
        const count = Array.isArray(list) ? list.length : 0;

        const onComparePage = /\/compare\/?$/.test(location.pathname);
        if (count > 0 && !onComparePage) {
          counter.textContent = `${count}/4`;
          tray.classList.remove('hidden');
        } else {
          tray.classList.add('hidden');
        }
      } catch {
        tray.classList.add('hidden');
      }
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        localStorage.setItem('qj-compare', JSON.stringify([]));
        window.dispatchEvent(new CustomEvent('qj:compare-updated'));
      });
    }

    window.addEventListener('storage', refresh);
    window.addEventListener('qj:compare-updated', refresh);
    refresh();
  }

  setupCompareTray();
</script>
