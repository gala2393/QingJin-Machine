# Generate each secret with: openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
# 2 when Cloudflare proxies to this server, 1 when clients hit nginx directly
TRUST_PROXY=2
# Hostname of the preview site (add it in Cloudflare DNS, proxied), e.g. preview.example.com
PREVIEW_HOST=
# Number of built releases kept on disk (rollback rebuilds from the stored snapshot, so older ones still work)
KEEP_RELEASES=10
# Daily backup time (Asia/Shanghai) and how many database/uploads backups to keep
BACKUP_AT=03:30
BACKUP_KEEP=14
# Raw analytics events older than this are deleted (daily totals are kept forever)
TRACK_RETENTION_DAYS=180
