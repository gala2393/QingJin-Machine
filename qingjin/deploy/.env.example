# Private deployment values: intentionally blank; never commit the populated .env.
# Generate each secret with: openssl rand -hex 48
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
# Initial admin values are supplied only to the first seed command, not on normal startup.
# Leave real credentials out of Git. Public local-only example: admin / 1234567890.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Build-time footer text: intentionally blank. Configure privately before a production publish.
ICP_RECORD_NUMBER=
# Proxy hops: Tencent edge + internal nginx = 2; a single direct nginx = 1.
TRUST_PROXY=2
# Tencent production preview shares the authenticated admin hostname.
PREVIEW_HOST=admin.qingjinmachinery.cn
# Number of built releases kept on disk (rollback rebuilds from the stored snapshot, so older ones still work)
KEEP_RELEASES=10
# Daily backup time (Asia/Shanghai) and how many database/uploads backups to keep
BACKUP_AT=03:30
BACKUP_KEEP=7
# Raw analytics events older than this are deleted (daily totals are kept forever)
TRACK_RETENTION_DAYS=180
