{
  "name": "qingjin-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:dev": "node scripts/dev-db.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "import:site": "ts-node --transpile-only src/cli/import-site.ts",
    "seed:admin": "ts-node --transpile-only src/cli/seed-admin.ts",
    "import:site:prod": "node dist/cli/import-site.js",
    "seed:admin:prod": "node dist/cli/seed-admin.js",
    "publish:site": "ts-node --transpile-only src/cli/publish.ts",
    "publish:site:prod": "node dist/cli/publish.js",
    "smoke": "node scripts/smoke.mjs",
    "smoke:write": "ts-node --transpile-only scripts/smoke-phase2.ts",
    "smoke:publish": "ts-node --transpile-only scripts/smoke-phase3.ts",
    "smoke:admin": "ts-node --transpile-only scripts/smoke-phase456.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "pg": "^8.23.1",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
