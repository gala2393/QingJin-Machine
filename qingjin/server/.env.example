PORT=3000
DATABASE_URL=postgresql://qingjin:qingjin_dev@127.0.0.1:5433/qingjin

# Use long random strings in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Comma-separated origins allowed to call the API from a browser (admin dev server)
CORS_ORIGINS=http://localhost:5174

UPLOAD_DIR=./uploads
# Existing Astro showcase site, used by the import script and (later) the publish pipeline
SITE_DIR=../../qingjin-site

# Initial super admin created by `npm run seed:admin`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Publishing: builds go to PUBLISH_DIR/releases/v<N>; PUBLISH_DIR/current is what the public site serves
PUBLISH_DIR=./publish
KEEP_RELEASES=10
# Preview site (own port / host, token-protected)
PREVIEW_PORT=4400
PREVIEW_PUBLIC_URL=http://localhost:4400
# Dev only: serve the published site locally (nginx does this in production)
SERVE_SITE_PORT=4321
# Public website address used by the admin's "访问官网 / 查看前台" links.
# Leave empty in dev to fall back to http://localhost:$SERVE_SITE_PORT; set it in production,
# e.g. SITE_PUBLIC_URL=https://www.qingjin-machinery.com
SITE_PUBLIC_URL=
